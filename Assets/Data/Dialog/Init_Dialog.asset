  lines:
  - speaker: {fileID: 11400000, guid: 33ffa64305d0e76418fa4c98b38bce9e, type: 2}
    clip: {fileID: 0}
    text: "Luchito, ven; si\xE9ntate conmigo."
    postDelay: 0.1
  - speaker: {fileID: 11400000, guid: 33ffa64305d0e76418fa4c98b38bce9e, type: 2}
    clip: {fileID: 0}
    text: "Cuando ten\xEDa tu edad viv\xED historias que todav\xEDa recuerdo muy
      bien."
    postDelay: 0.1
  - speaker: {fileID: 11400000, guid: 33ffa64305d0e76418fa4c98b38bce9e, type: 2}
    clip: {fileID: 0}
    text: "D\xE9jame contarte sobre ellas, para que puedas conocer un poquito m\xE1s
      de nuestro Per\xFA."
    postDelay: 0.1
