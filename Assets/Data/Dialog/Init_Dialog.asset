--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5cecf942c06f1494a991de1297c094fc, type: 3}
  m_Name: Init_Dialog
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speaker: {fileID: 11400000, guid: 90dd89e3f97f7fb43b3e7a38d05cb061, type: 2}
    clip: {fileID: 0}
    text: "\xA1Abuelo, abuelo! \nCuentame una de las historias de cuando vivias en
      Piura."
    postDelay: 0.1
  - speaker: {fileID: 11400000, guid: 33ffa64305d0e76418fa4c98b38bce9e, type: 2}
    clip: {fileID: 0}
    text: 'O la vez que casi te atrapa el Tunche en el Amazonas. '
    postDelay: 0.1
  - speaker: {fileID: 11400000, guid: 90dd89e3f97f7fb43b3e7a38d05cb061, type: 2}
    clip: {fileID: 0}
    text: "O tambi\xE9n cuando tocaste en el Cusco, donde conociste a mi abuela..."
    postDelay: 0.3
  - speaker: {fileID: 11400000, guid: 33ffa64305d0e76418fa4c98b38bce9e, type: 2}
    clip: {fileID: 0}
    text: "Calma hijo, ven, si\xE9ntate.\nRecordar esas historias me trae nostalgia."
    postDelay: 0.1
  - speaker: {fileID: 11400000, guid: 33ffa64305d0e76418fa4c98b38bce9e, type: 2}
    clip: {fileID: 0}
    text: "Han pasado muchos a\xF1os, pero hay recuerdos que el tiempo nunca logra
      borrar..."
    postDelay: 1
